# All keys are optional. Without keys the app runs fully offline-capable:
# rules engine + template reasons + browser speech (STT/TTS).

# extraction fallback, "why this crop" reasons, photo reports, STT fallback
GEMINI_API_KEY=
# Saaras v4 speech-to-text + Bulbul v3 text-to-speech
SARVAM_API_KEY=
# live mandi prices (falls back to dated snapshot)
DATA_GOV_API_KEY=

# Providers: auto picks the best one for the keys you set
# auto | sarvam | gemini | browser
STT_PROVIDER=auto
# auto | sarvam | browser
TTS_PROVIDER=auto
# auto | gemini | none
LLM_PROVIDER=auto
# ML model is left for later (rules only)
ML_ENABLED=false

# Models
GEMINI_MODEL=gemini-3.5-flash-lite
# or gemini-3.5-transcribe (low-latency STT)
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_SCHEMA_STYLE=response_format
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
TTS_PACE=0.9

# URLs (override to point at mocks in tests)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
SARVAM_BASE_URL=https://api.sarvam.ai
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Runtime
HTTP_TIMEOUT_S=12
LLM_TIMEOUT_S=8
# DB_PATH=backend/data/apni_kheti.db
# CACHE_DIR=backend/data/cache
# FRONTEND_DIST=frontend/dist
# e.g. 2026-10-17 to pin "today" for demos
APP_TODAY=
